	(text "MCU GPIO breakout - 2.54 mm male pin headers (J8 port A, J9 port B, J10 ports C/D)\nEvery spare STM32 pin is brought out by global label; the last pin of each header is GND."
		(exclude_from_sim no)
		(at 309.88 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "062a9078-b6b1-4cd9-a0e4-115a735a6a51")
	)
	(text "power led indicator"
		(exclude_from_sim no)
		(at 32.004 116.332 0)
		(effects
