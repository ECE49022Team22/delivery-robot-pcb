			)
			(justify left top)
		)
		(uuid "074bd2c2-2d1b-4d47-b2c1-96832da4ac92")
	)
	(text "Motor 1 off-board connections (Cytron MDD20A driver + 37D encoder motor)\nPWM on TIM3 (PA6), encoder on TIM2 (PA15 / PB3).\nEncoder Vcc is +5V, 2A from the TPS54202 buck (before the LDO), not from the MCU.\nDriver VB+/VB- (6-30 V battery) and M1A/M1B wire directly to the MDD20A (not on this board)."
		(exclude_from_sim no)
		(at 181.61 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0e50440d-e953-44f9-8aef-2ec31f2abece")
	)
	(text "IMU - BNO085 breakout (off-board)"
		(exclude_from_sim no)
		(at 339.09 154.94 0)
		(effects
