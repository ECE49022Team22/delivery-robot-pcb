	)
	(text "I2C1 AF1: PB6 SCL, PB7 SDA\nINT -> PC4 (EXTI4), RST -> PC5\nJ11 STEMMA QT: 1 GND, 2 3V3, 3 SDA, 4 SCL\nR10/R11 DNP: breakout has pull-ups"
		(exclude_from_sim no)
		(at 334.01 218.95 0)
		(effects
