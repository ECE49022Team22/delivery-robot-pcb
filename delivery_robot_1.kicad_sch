	)
	(text "J13 1 <- Pi GPIO14 TXD (header pin 8)\nJ13 2 -> Pi GPIO15 RXD (header pin 10)\nJ13 3 = GND (Pi header pin 6); 3.3 V logic\nR12/R13 near U1, U5 ESD near J13"
		(exclude_from_sim no)
		(at 256.286 192.532 0)
