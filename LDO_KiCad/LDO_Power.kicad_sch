	(text "C2: require >= 4.7uF EFFECTIVE capacitance; selected part modeled at 8.8uF.\nEN tied to IN. C3 sets noise reduction / soft start; C4 bypasses R1."
		(exclude_from_sim no)
		(at 60.96 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
