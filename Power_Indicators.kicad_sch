	(text "LED current ~2-2.7 mA: R = (Vrail - 2.0 V) / I. +12V uses 4.7k for the 10.8-14.6 V battery range.\nAll resistors 0805; worst-case dissipation 34 mW (R17 at 14.6 V)."
		(exclude_from_sim no)
		(at 50.8 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "41b0d613-0359-423b-bc25-bf67f75c580d")
	)
	(text "PA5 LED_USER: heartbeat\nPB12 LED_PI_LINK: Pi UART activity\nPB13 LED_IMU: IMU data-ready\nPB14 LED_MOTOR: motor running / fault\n680R: (3.3 - 2.1) / 680 = 1.8 mA per pin"
		(exclude_from_sim no)
		(at 165.1 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7097a718-794c-4453-8661-adb32cc8f111")
	)
