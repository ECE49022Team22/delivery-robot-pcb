	(text "+5V_AUX peripheral outputs - four ports, one PTC each"
		(exclude_from_sim no)
		(at 25.4 25.4 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "5a0e79d4-18e0-4377-9d90-68ba7d8d9e06")
	)
	(text "+5V_AUX comes from U5 (TPSM63606, 6 A), which is enabled when the Pi 5 is up (AUX_EN, see Buck 5V AUX).\nEach port has its own PTC so a pinched or shorted peripheral cable only drops that port.\nConnectors: JST XH 2.5 mm top-entry (plug in from above), keyed, 3 A per contact.\nUse pre-made 2-pin XH cables; solder or splice the free end at each peripheral. Pin 1 = +5 V, pin 2 = GND.\nPTC hold is 1.5 A on every port (trip about 3 A) so one part covers all four; bursts of 2 A for\nmilliseconds (Notecard modem) do not trip it. Check each peripheral's peak current before power-up.\nLayout: ports on one board edge next to U5; PTCs at the connectors; +5V_AUX on a pour."
		(exclude_from_sim no)
		(at 25.4 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "99765bb4-c42a-4dfc-89b4-46bde341eef2")
	)
