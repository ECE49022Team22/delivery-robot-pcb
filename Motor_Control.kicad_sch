	(text "Motor control - Cytron MDD20A dual-channel driver + two 37D encoder motors"
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "2e8bc2ef-2807-43c5-b79e-39b0537c8fe2")
	)
	(text "STM32F091 PIN ASSIGNMENT\n\nMotor 1  (J6 driver, J7 encoder)\n  MOTOR1_PWM  PA6   TIM3_CH1  -> MDD20A PWM1\n  MOTOR1_DIR  PB0   GPIO      -> MDD20A DIR1\n  ENC1_A      PA15  TIM2_CH1  <- encoder A (yellow)\n  ENC1_B      PB3   TIM2_CH2  <- encoder B (white)\n\nMotor 2  (J16 driver, J15 encoder)\n  MOTOR2_PWM  PA7   TIM3_CH2  -> MDD20A PWM2\n  MOTOR2_DIR  PB2   GPIO      -> MDD20A DIR2\n  ENC2_A      PA8   TIM1_CH1  <- encoder A (yellow)\n  ENC2_B      PA9   TIM1_CH2  <- encoder B (white)\n\nTimers: TIM3 = both PWMs (same frequency, <= 20 kHz for MDD20A)\n        TIM2 = encoder 1, TIM1 = encoder 2 (encoder mode)\nEncoders powered from +5V, 2A; A/B pins must be 5 V tolerant (FT).\nDriver VB+/VB- (battery) and M1A/M1B, M2A/M2B wire directly to the MDD20A."
		(exclude_from_sim no)
		(at 127 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "721ff8e8-dfae-4340-b884-7d4408af366a")
	)
)
