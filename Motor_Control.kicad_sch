	)
	(text "Motor control - Cytron MDD20A dual-channel driver + two AndyMark PG27 motors with am-3651 encoders"
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "31d45c15-c8a3-4797-9ed6-045dbeab02ee")
	)
	(text "Off-board connectors"
		(exclude_from_sim no)
		(at 111.76 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4b505d90-f563-42c4-a374-2b010a228e66")
	)
	(text "STM32F091 PIN ASSIGNMENT          series R    connector\n  MOTOR1_PWM  PA6   TIM3_CH1    R26 100R    J6 pin 1 -> MDD20A PWM1 (R52 10k pull-down)\n  MOTOR1_DIR  PB0   GPIO        R27 100R    J6 pin 2 -> MDD20A DIR1\n  ENC1_A      PA15  TIM2_CH1    U9 <- R28 1k    J7 pin 3 <- encoder A\n  ENC1_B      PB3   TIM2_CH2    U9 <- R29 1k    J7 pin 4 <- encoder B\n  MOTOR2_PWM  PA7   TIM3_CH2    R30 100R    J16 pin 1 -> MDD20A PWM2 (R53 10k pull-down)\n  MOTOR2_DIR  PB2   GPIO        R31 100R    J16 pin 2 -> MDD20A DIR2\n  ENC2_A      PA8   TIM1_CH1    U10 <- R32 1k   J15 pin 3 <- encoder A\n  ENC2_B      PA9   TIM1_CH2    U10 <- R33 1k   J15 pin 4 <- encoder B\nTimers: TIM3 = both PWMs (<= 20 kHz for MDD20A); TIM2 = encoder 1, TIM1 = encoder 2.\nEncoders: 5 V parts. The +3V3 rail comes up after +5V_SYS, and ST allows only 3.6 V on any pin while VDD = 0 (AN4899),\nso A/B go through U9/U10 (74LVC2G17 on +3V3) instead of straight to the MCU. Never enable internal pull-ups on these pins.\nPWM pull-downs: MDD20A brakes on PWM low, so a resetting MCU always means 'brake'.\nJ6/J16 pin 3 is a signal reference only (through F10/F11). Battery and motor leads wire directly to the MDD20A."
		(exclude_from_sim no)
		(at 25.4 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5a527e6e-bb4b-498d-aafe-d4bb1770db03")
	)
	(text "Series resistors (MCU side): 100R driver lines, 1k encoder lines"
		(exclude_from_sim no)
		(at 27.94 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d24a1b42-39bf-43ff-b986-c30ce9e8769b")
	)
	(text "Encoder input buffers - 74LVC2G17 on +3V3 (inputs tolerate 5.5 V, even unpowered)"
