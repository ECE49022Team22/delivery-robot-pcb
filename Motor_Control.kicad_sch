	(text "Motor control - Cytron MDD20A dual-channel driver + two 37D encoder motors"
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "31d45c15-c8a3-4797-9ed6-045dbeab02ee")
	)
	(text "STM32F091 PIN ASSIGNMENT          series R    connector\n  MOTOR1_PWM  PA6   TIM3_CH1    R26 100R    J6 pin 1 -> MDD20A PWM1\n  MOTOR1_DIR  PB0   GPIO        R27 100R    J6 pin 2 -> MDD20A DIR1\n  ENC1_A      PA15  TIM2_CH1    R28 100R    J7 pin 2 <- encoder A (yellow)\n  ENC1_B      PB3   TIM2_CH2    R29 100R    J7 pin 3 <- encoder B (white)\n  MOTOR2_PWM  PA7   TIM3_CH2    R30 100R    J16 pin 1 -> MDD20A PWM2\n  MOTOR2_DIR  PB2   GPIO        R31 100R    J16 pin 2 -> MDD20A DIR2\n  ENC2_A      PA8   TIM1_CH1    R32 100R    J15 pin 2 <- encoder A (yellow)\n  ENC2_B      PA9   TIM1_CH2    R33 100R    J15 pin 3 <- encoder B (white)\nTimers: TIM3 = both PWMs (<= 20 kHz for MDD20A); TIM2 = encoder 1, TIM1 = encoder 2.\nESD: USBLC6-4SC6 arrays on motor 1 only - U6 on J6 PWM/DIR (VBUS +3V3), U7 on J7 encoder A/B (VBUS +5V 2A). Encoders powered from +5V, 2A;\nA/B pins must be 5 V tolerant (FT). Battery and motor leads wire directly to the MDD20A."
		(exclude_from_sim no)
		(at 25.4 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5a527e6e-bb4b-498d-aafe-d4bb1770db03")
	)
)
